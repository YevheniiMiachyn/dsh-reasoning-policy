# Normalize to LF everywhere.
#
# This source tree also happens to be the live production mount point for the
# plugin, so line-ending rewriting must never happen implicitly: the checked-out
# bytes must stay identical to the promoted, hash-verified bytes.

* text=auto eol=lf

*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
LICENSE text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# Binary-ish files are never touched.
*.png binary
*.jpg binary
*.ico binary
*.wav binary
*.gguf binary
